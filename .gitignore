# Build output
build/
vcpkg_installed/
packages/

# Generated docs site (mkdocs build / mkdocs serve); published via the docs
# workflow to the gh-pages branch, never committed to develop/main.
site/

# Machine-local CMake presets (carry local VCPKG_ROOT)
CMakeUserPresets.json

# IDE / tooling
.vs/
.cache/
*.user

# Python tooling for golden-vector generation
__pycache__/

# Downloaded standards documents (free from ATSC/ETSI; not redistributed here)
docs/spec/

# The signing key MUST NOT reach a public remote. The EMDF object signer itself
# (src/signing) is committed clean-room - only the key is secret, supplied at
# runtime. The desktop tools take it by path/env (never a file in the tree),
# but the Shield app signs on-device and so reads it from a bundled asset: that
# asset is written from a CI secret at build time and must never be committed.
platform/android/app/src/main/assets/signing.key

# The older RE-derived signer OVERLAY predates the committed src/signing and is
# still quarantined: it additionally embeds the key extracted from Dolby's
# binary (see its README on its own branch) and must never leave a local
# branch. Ignoring it here means it cannot be staged by accident; a CI "no
# quarantine on main" check backs this up.
src/quarantine/

# Grown fuzzing corpus and crash artifacts (fuzz/run.sh): reproducible from
# fuzz/seeds/ plus a mutation budget, and can grow large. What must survive a
# fix - the minimized input that proved a bug - lives in fuzz/regressions/
# instead, which IS tracked.
fuzz/corpus/
fuzz/artifacts/
