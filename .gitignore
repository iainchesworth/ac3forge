# Build output
build/
vcpkg_installed/

# Machine-local CMake presets (carry local VCPKG_ROOT)
CMakeUserPresets.json

# IDE / tooling
.vs/
.cache/
*.user

# Python tooling for golden-vector generation
__pycache__/

# Downloaded standards documents (free from ATSC/ETSI; not redistributed here)
docs/spec/

# The RE-derived EMDF signer is quarantined and MUST NOT reach a public remote:
# it embeds a key extracted from Dolby's binary (see its README on its own
# branch). It lives only on a local branch, never on main/develop. Ignoring it
# here means it cannot be staged onto an integration branch by accident; a CI
# "no quarantine on main" check backs this up.
src/quarantine/

# Grown fuzzing corpus and crash artifacts (fuzz/run.sh): reproducible from
# fuzz/seeds/ plus a mutation budget, and can grow large. What must survive a
# fix - the minimized input that proved a bug - lives in fuzz/regressions/
# instead, which IS tracked.
fuzz/corpus/
fuzz/artifacts/
