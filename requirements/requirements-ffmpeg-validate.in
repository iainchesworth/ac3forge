# that function's own docstring for why this is fine to add directly here
# unlike visqol-python, which stays deliberately out of this lock.
# Regenerate the lock after any change here with:
#   python -m piptools compile --generate-hashes --strip-extras \
#     --output-file=requirements-ffmpeg-validate.txt requirements-ffmpeg-validate.in
numpy
matplotlib
