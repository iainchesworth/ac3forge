{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "core",
      "hidden": true,
      "description": "Shared configuration for every platform/compiler preset. NOTE: VCPKG_CHAINLOAD_TOOLCHAIN_FILE is the single source of truth for the chainloaded compiler toolchain and is set per concrete preset; the vcpkg overlay triplets must NOT also set it.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "AC3FORGE_BUILD_CLI": "ON",
        "AC3FORGE_BUILD_TESTS": "ON",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg/triplets"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "windows-msvc",
      "hidden": true,
      "description": "Windows/MSVC toolchain selection, shared by the Release and Debug presets. The compiler is pinned through the chainloaded toolchain rather than left to PATH: cl.exe is not on PATH outside a Developer PowerShell, so an unpinned Ninja configure resolves to whatever else is there (clang) and builds something nobody asked for. The toolchain imports the MSVC environment itself, so these presets configure from any shell.",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-msvc",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows.msvc.toolchain.cmake",
        "AC3FORGE_BUILD_GUI": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-llvm",
      "hidden": true,
      "description": "Windows/clang-cl toolchain selection. clang-cl is MSVC-ABI compatible, so it links the same vcpkg packages and the same prebuilt msvc2022_64 Qt kit as the MSVC presets.",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-llvm",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows.llvm.toolchain.cmake",
        "AC3FORGE_BUILD_GUI": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-gcc",
      "hidden": true,
      "description": "Linux/GCC 15 toolchain selection. The GUI is off because a Qt kit is not assumed present, NOT because it cannot be built: cmake/FindQt6.cmake resolves Linux kits fine (distro packages land on CMake's own prefixes, and relocated / aqtinstall kits are searched under ~/Qt, /opt/Qt and friends), and ac3gui builds under both Linux presets and passes its headless --smoke run against Ubuntu 26.04's Qt 6.10. Add -DAC3FORGE_BUILD_GUI=ON on a machine that has Qt 6.5+; a preset that cannot find Qt should still say so by not asking for it rather than by failing to configure.",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-gcc",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux.gcc.toolchain.cmake",
        "AC3FORGE_BUILD_GUI": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-llvm",
      "hidden": true,
      "description": "Linux/LLVM 21 toolchain selection. GUI off for the same reason as linux-gcc.",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-llvm",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux.llvm.toolchain.cmake",
        "AC3FORGE_BUILD_GUI": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-gcc-arm64",
      "hidden": true,
      "description": "Linux/GCC 15 toolchain selection, arm64 (Raspberry Pi 4/5 and any other aarch64 Debian/Ubuntu target). Same toolchain file as linux-gcc - cmake/toolchains/linux.gcc.toolchain.cmake already resolves aarch64 vs x86_64 from VCPKG_TARGET_ARCHITECTURE - only the vcpkg triplet differs. GUI off for the same reason as linux-gcc.",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-linux-gcc",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux.gcc.toolchain.cmake",
        "AC3FORGE_BUILD_GUI": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-llvm-arm64",
      "hidden": true,
      "description": "Linux/LLVM 21 toolchain selection, arm64 (Raspberry Pi 4/5 and any other aarch64 Debian/Ubuntu target). Same toolchain file as linux-llvm - cmake/toolchains/linux.llvm.toolchain.cmake already resolves aarch64 vs x86_64 from VCPKG_TARGET_ARCHITECTURE - only the vcpkg triplet differs. GUI off for the same reason as linux-gcc.",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-linux-llvm",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux.llvm.toolchain.cmake",
        "AC3FORGE_BUILD_GUI": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-llvm",
      "hidden": true,
      "description": "macOS (Apple Silicon)/Homebrew LLVM toolchain selection. Verified via CI only (this project has no local macOS host) - see docs/BUILDING.md's Verified configuration section. GUI off for the same reason as linux-gcc.",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-macos-llvm",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/macos.llvm.toolchain.cmake",
        "AC3FORGE_BUILD_GUI": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "name": "sanitize-asan-ubsan",
      "hidden": true,
      "description": "AddressSanitizer + UndefinedBehaviorSanitizer, fatal on first violation (-fno-sanitize-recover=all in cmake/Sanitizers.cmake) rather than logging and continuing. Deliberately does NOT add -fsanitize=integer's unsigned-integer-overflow check: this codec relies on intentional unsigned wraparound (CRC16, ring-buffer indices, the splice counter), and blanket-enabling it drowns real findings in expected wraparound. Signed overflow and out-of-range shifts - the precedent bug's own category (commit 8386c8f) - are already part of the default 'undefined' set.",
      "cacheVariables": {
        "AC3FORGE_SANITIZERS": "address,undefined"
      }
    },
    {
      "name": "coverage",
      "hidden": true,
      "description": "gcov source coverage instrumentation (cmake/Coverage.cmake) over ac3::forge and ac3tests. CLI and examples are off: both link ac3::forge, and an instrumented library's gcov runtime symbols would otherwise need resolving on their link lines too for no coverage benefit, since gcovr's report is filtered to src/lib/.* anyway - see .github/workflows/ci.yml's coverage job.",
      "cacheVariables": {
        "AC3FORGE_ENABLE_COVERAGE": "ON",
        "AC3FORGE_BUILD_CLI": "OFF",
        "AC3FORGE_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "shared-libs",
      "hidden": true,
      "description": "BUILD_SHARED_LIBS=ON, proving ac3::forge_shared/matroska::matroska_shared actually work - not just that the CMake topology configures, but that every in-tree consumer (ac3cli/ac3gui/ac3tests/examples) links and runs against the real .so, including the one example that also needs matroska's .so alongside ac3forge's. See .github/workflows/_build.yml's 'Configure, build and test with BUILD_SHARED_LIBS=ON' step, which runs this as an extra pass inside the existing linux-llvm leg rather than a new matrix entry - the same shape as the alsa_fallback step below it.",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    },

    {
      "name": "config-windows-msvc",
      "inherits": [ "release", "windows-msvc", "core" ],
      "displayName": "Windows MSVC Release"
    },
    {
      "name": "config-windows-msvc-debug",
      "inherits": [ "debug", "windows-msvc", "core" ],
      "displayName": "Windows MSVC Debug"
    },
    {
      "name": "config-windows-llvm",
      "inherits": [ "release", "windows-llvm", "core" ],
      "displayName": "Windows LLVM Release (clang-cl)"
    },
    {
      "name": "config-windows-llvm-debug",
      "inherits": [ "debug", "windows-llvm", "core" ],
      "displayName": "Windows LLVM Debug (clang-cl)"
    },
    {
      "name": "config-linux-gcc",
      "inherits": [ "release", "linux-gcc", "core" ],
      "displayName": "Linux GCC Release"
    },
    {
      "name": "config-linux-gcc-debug",
      "inherits": [ "debug", "linux-gcc", "core" ],
      "displayName": "Linux GCC Debug"
    },
    {
      "name": "config-linux-llvm",
      "inherits": [ "release", "linux-llvm", "core" ],
      "displayName": "Linux LLVM Release"
    },
    {
      "name": "config-linux-llvm-debug",
      "inherits": [ "debug", "linux-llvm", "core" ],
      "displayName": "Linux LLVM Debug"
    },
    {
      "name": "config-linux-gcc-arm64",
      "inherits": [ "release", "linux-gcc-arm64", "core" ],
      "displayName": "Linux GCC Release (arm64)"
    },
    {
      "name": "config-linux-gcc-arm64-debug",
      "inherits": [ "debug", "linux-gcc-arm64", "core" ],
      "displayName": "Linux GCC Debug (arm64)"
    },
    {
      "name": "config-linux-llvm-arm64",
      "inherits": [ "release", "linux-llvm-arm64", "core" ],
      "displayName": "Linux LLVM Release (arm64)"
    },
    {
      "name": "config-linux-llvm-arm64-debug",
      "inherits": [ "debug", "linux-llvm-arm64", "core" ],
      "displayName": "Linux LLVM Debug (arm64)"
    },
    {
      "name": "config-macos-llvm",
      "inherits": [ "release", "macos-llvm", "core" ],
      "displayName": "macOS LLVM Release"
    },
    {
      "name": "config-macos-llvm-debug",
      "inherits": [ "debug", "macos-llvm", "core" ],
      "displayName": "macOS LLVM Debug"
    },
    {
      "name": "config-linux-llvm-asan-ubsan",
      "inherits": [ "debug", "linux-llvm", "sanitize-asan-ubsan", "core" ],
      "displayName": "Linux LLVM ASan+UBSan"
    },
    {
      "name": "config-linux-gcc-coverage",
      "inherits": [ "debug", "linux-gcc", "coverage", "core" ],
      "displayName": "Linux GCC Coverage"
    },
    {
      "name": "config-linux-llvm-shared",
      "inherits": [ "debug", "linux-llvm", "shared-libs", "core" ],
      "displayName": "Linux LLVM Shared (BUILD_SHARED_LIBS=ON)"
    }
  ],

